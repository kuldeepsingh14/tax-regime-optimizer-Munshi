# Copy to .env for local development. Never commit the real .env.
# All of these are optional — the app runs with none of them set.

ALLOWED_ORIGINS=http://localhost:4200

# auto | fastembed | lexical
EMBEDDER=lexical

# Extraction falls back to regex-only without this.
GROQ_API_KEY=

# Falls back to the in-memory store without this.
PINECONE_API_KEY=
